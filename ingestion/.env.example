# Social-stats ingestion credentials. Copy to ingestion/.env on the machine
# that runs the job and fill in real values there; .env is gitignored.
# NEVER commit a real service-role key, and never paste one into chat:
# hand it over through the Secure Vault (see ingestion/README.md, go-live).

# The Supabase project behind marketing.integratedstaffing.com,
# e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# service_role key for that project (Project Settings -> API). It bypasses
# RLS by design; the writer in socialstats/writer.py is built to only ever
# replace the machine-owned sections and carry the human-owned ones through.
SUPABASE_SERVICE_ROLE_KEY=
